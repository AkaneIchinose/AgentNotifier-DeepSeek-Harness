<Window x:Class="AgentNotifier.App.NotifyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Agent 提醒"
        Width="416"
        SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <!-- 四周预留 22px 透明边距：阴影在窗口内渲染，不会被窗口矩形裁剪出灰色直角 -->
    <Grid Margin="22">
        <Border x:Name="Root" CornerRadius="12" Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                MouseLeftButtonDown="Root_MouseLeftButtonDown" Cursor="Hand">
            <Border.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="2.5" Direction="270" Opacity="0.32" Color="#000000"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border x:Name="BannerHost" Grid.Row="0" Visibility="Collapsed"
                        CornerRadius="12,12,0,0" Background="{DynamicResource AccentBrush}"
                        SizeChanged="BannerHost_SizeChanged">
                    <Image x:Name="BannerImage" Stretch="UniformToFill" Height="110"/>
                </Border>
                <StackPanel Grid.Row="1" Margin="16,12,12,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="TypeChip" CornerRadius="9" Padding="9,2" VerticalAlignment="Center">
                                <TextBlock x:Name="TypeText" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                            </Border>
                            <Border x:Name="ModelChip" CornerRadius="9" Padding="9,2" Margin="6,0,0,0"
                                    VerticalAlignment="Center" Visibility="Collapsed">
                                <TextBlock x:Name="ModelText" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                            </Border>
                            <TextBlock x:Name="AgentText" Margin="8,0,0,0" FontSize="11" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <Border Grid.Column="1" x:Name="CloseBtn" Width="22" Height="22" CornerRadius="11"
                                Background="Transparent" Cursor="Hand" MouseLeftButtonDown="Close_Click">
                            <TextBlock Text="✕" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Border>
                    </Grid>
                    <TextBlock x:Name="TitleText" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,0"
                               Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="BodyText" FontSize="12" Margin="0,6,0,0"
                               Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="SummaryText" FontSize="11" Margin="0,6,0,0" Visibility="Collapsed"
                               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="FooterText" FontSize="10" Margin="0,10,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
